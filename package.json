{
  "name": "dsh-peaktime-clock",
  "version": "1.0.1",
  "description": "Persistent DeepSeek peak-time whale widget: corner clock that turns red during DeepSeek peak-price windows and green off-peak, in local time.",
  "license": "MIT",
  "homepage": "https://github.com/tingao/dsh-peaktime-clock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingao/dsh-peaktime-clock.git"
  },
  "bugs": {
    "url": "https://github.com/tingao/dsh-peaktime-clock/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "peak",
    "peaktime",
    "whale",
    "clock",
    "pricing"
  ]
}
